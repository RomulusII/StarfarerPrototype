<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS için MIME eşlemesi. Şablon klasöründe durur, yani Unity her build'de
  çıktının köküne kopyalar ve dağıtımla birlikte gider.

  NEDEN GEREKLİ: IIS tanımadığı uzantıyı servis ETMEZ, 404.3 döner. Unity'nin
  ürettiği paket dosyaları .unityweb uzantılıdır ve IIS bunu bilmez — yani
  dosyalar sunucuda dururken oyun boş ekranla açılır ve sebebi sunucu
  günlüğüne bakmadan anlaşılmaz.

  <remove> satırları, üst seviye bir web.config aynı uzantıyı zaten
  tanımlıyorsa çıkan "duplicate entry" 500 hatasını önler.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".unityweb" />
      <mimeMap fileExtension=".unityweb" mimeType="application/octet-stream" />

      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />

      <remove fileExtension=".data" />
      <mimeMap fileExtension=".data" mimeType="application/octet-stream" />

      <remove fileExtension=".symbols.json" />
      <mimeMap fileExtension=".symbols.json" mimeType="application/octet-stream" />

      <!-- Android paketi de bu klasörde durur. Üst klasöre ayrı bir web.config
           koymak denendi ve işe yaramadı; IIS yapılandırması üste doğru
           işlemediği için paketi ZATEN ÇALIŞAN yapılandırmanın kapsamına
           almak tek adımda çözüyor. -->
      <remove fileExtension=".apk" />
      <mimeMap fileExtension=".apk" mimeType="application/vnd.android.package-archive" />
    </staticContent>
  </system.webServer>
</configuration>
