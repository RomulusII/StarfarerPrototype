<?xml version="1.0" encoding="utf-8"?>
<!--
  SUNUCUDA NEREYE KONUR:
      httpdocs/Starfarer/web.config
  yani APK'nın DURDUĞU klasöre — game/ klasörüne değil.

  NEDEN AYRI BİR DOSYA: IIS yapılandırması bulunduğu klasör ve ALTI için
  geçerlidir, üste doğru işlemez. game/ içindeki web.config (WebGL şablonundan
  gelir, .unityweb eşlemesini yapar) bir üstteki Starfarer.apk'yı kapsamaz.

  NEDEN GEREKLİ: IIS tanımadığı uzantıyı servis ETMEZ, 404.3 döner. Plesk'in
  genel hata sayfası alt durumu gizlediği için bu dışarıdan düz bir 404 gibi
  görünür: dosya sunucuda durur, klasör doğru eşlenmiştir, yine de indirilemez.

  requestFiltering bloğu ikinci olasılığı kapatır — bazı barındırma
  yapılandırmaları .apk uzantısını açıkça reddeder (404.7).

  Bu dosya oyunun build çıktısıyla GELMEZ; sunucuya bir kez elle konur ve
  orada kalır.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".apk" />
      <mimeMap fileExtension=".apk" mimeType="application/vnd.android.package-archive" />
    </staticContent>

    <security>
      <requestFiltering>
        <fileExtensions>
          <remove fileExtension=".apk" />
          <add fileExtension=".apk" allowed="true" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
