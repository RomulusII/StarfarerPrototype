# Unity için önerilen gitignore

# Genel Unity klasörleri ve dosyaları
/StarfarerPrototype/[Ll]ibrary/
/StarfarerPrototype/[Tt]emp/
/StarfarerPrototype/[Oo]bj/
/StarfarerPrototype/[Bb]uild/
/StarfarerPrototype/[Bb]uilds/
/StarfarerPrototype/[Ll]ogs/
/StarfarerPrototype/[Uu]ser[Ss]ettings/
/StarfarerPrototype/[Mm]emoryCaptures/

# Asset Store araçları klasörü
/[Aa]ssets/AssetStoreTools*

# Visual Studio / VS Code / Rider
.vs/
.vscode/
.idea/
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D tarafından oluşturulan dosyalar
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D crash raporları
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app
*.exe
*.x86_64
*.x86

# Crashlytics
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# MacOS sistem dosyaları
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?
ehthumbs.db
[Tt]humbs.db

# Windows sistem dosyaları
Thumbs.db
Desktop.ini

# JetBrains Rider
*.sln
*.csproj

# Claude Code geçici worktree dizinleri
.claude/worktrees/
StarfarerPrototype/.claude/worktrees/

# ASLA yoksayılmaması gereken dosyalar
!*.meta
!*.unity
!*.prefab
!*.mat
!*.asset

# SkinGen onizleme ciktilari - uretilebilir, repoya girmez
/StarfarerPrototype/Tools/SkinGen/*.png

# Denge kayitlari - sunucudan indirilir, uretilebilir veri
/StarfarerPrototype/Tools/Balance/logs/

# Indirici yapilandirmasi - TOKEN icerir, repoya GIRMEMELI
/StarfarerPrototype/Tools/Balance/pull.config.json

# Performance testing paketinin build sirasinda yazdigi iskelet dosyalar.
# Yollari pakette sabit kodlu (Utils.cs: "Assets/Resources/..."), tasinamaz --
# Resources.Load yalnizca oradan okur. Basarili build sonunda Cleanup() siler;
# yalnizca build cokerse geride kalirlar.
/StarfarerPrototype/Assets/Resources/PerformanceTestRun*.json
/StarfarerPrototype/Assets/Resources/PerformanceTestRun*.json.meta

# Gradle/CMake ara ciktisi - Android build uretir
/StarfarerPrototype/.utmp/

# Log gonderim ayari - TOKEN icerir ve repo herkese acik: repoya GIRMEMELI.
# Asset yoksa gonderim kendini kapatir (UploadConfig.Active), oyun calisir.
# Yeni bir makinede: Create > Starfarer > Upload Config, Assets/Resources/ altina.
/StarfarerPrototype/Assets/Resources/UploadConfig.asset
/StarfarerPrototype/Assets/Resources/UploadConfig.asset.meta
